{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(smtp_send_message|smtp_reply_message|graph_send_message|ews_send_message)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{config_dir}}/hooks/mail-send-guard/mail-send-guard\"",
            "timeout": 10,
            "statusMessage": "Checking outbound mail..."
          }
        ]
      }
    ]
  }
}
