#!/usr/bin/env bash

#?/name     install — Link this repo's items into Claude Code config dirs
#?/version  4.0.0
#?/synopsis install [doctor] [config_dirs...]
#?/description
 # Symlinks each linked item into a config dir. From clients/claude/:
 # skills/<name>/ (a directory with SKILL.md) to <config_dir>/skills/<name>,
 # output-styles/<name>.md to <config_dir>/output-styles/<name>.md, and
 # hooks/<name>/ (a directory with settings.json) to <config_dir>/hooks/<name>.
 # From common/: instructions/AGENTS.md to <config_dir>/CLAUDE.md, the fixed
 # name Claude Code reads global instructions from.
 #
 # A hook's settings.json is a fragment holding the `hooks` entries it needs
 # in <config_dir>/settings.json, with {{config_dir}} standing for the config
 # dir; install merges them in and removes entries it owns that no hook
 # wants any more.
 #
 # A config dir opts out of items with <config_dir>/.agent-tooling-ignore,
 # one `<kind>/<name>` per line as linked (`skills/make-it-so`,
 # `output-styles/eli5.md`); `#` lines and blank lines are skipped. An
 # ignored item's link and settings entries are removed if present.
 #
 # With no subcommand, installs. `doctor` reports without changing anything.
 # A config dir defaults to $CLAUDE_CONFIG_DIR, or ~/.claude when that is
 # unset. Never replaces anything that isn't one of its own links or
 # entries, and removes its links whose item no longer exists. Needs jq.
 ##

source module

set -euo pipefail

CLIENT_SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
readonly CLIENT_SRC
REPO_ROOT="$(cd "${CLIENT_SRC}/../.." && pwd -P)"
readonly REPO_ROOT

# Item kinds. Each names its source dir under clients/claude/ and its
# destination dir in a config dir, except instructions, which come from
# common/ and link to a fixed file name; see install::_src_root and
# install::_dest.
readonly KINDS=(instructions skills output-styles hooks)

readonly IGNORE_FILE=".agent-tooling-ignore"

#@/private
 # Log an error message to STDERR.
 #
 # @operand <message...>   Error message text
 # @stderr                 Error message
 ##
install::_err() {
  echo "install: ERROR: $*" >&2
}

#@/private
 # Print a config dir as an absolute physical path.
 #
 # @operand <dir>          Config dir, possibly relative or through symlinks
 #
 # @stdout                 Absolute path
 # @stderr                 Error when the dir doesn't exist
 #
 # @exit    0              Printed
 # @exit    1              The dir doesn't exist
 ##
install::_abs() {
  local dir="$1"

  if [[ ! -d "${dir}" ]]; then
    install::_err "config dir does not exist: ${dir}"
    return 1
  fi
  (cd "${dir}" && pwd -P)
}

#@/private
 # Print the config dirs to act on.
 #
 # @operand [config_dirs...]  Explicit config dirs
 # @env     CLAUDE_CONFIG_DIR Default config dir when no operands are given
 # @stdout                    One config dir per line
 ##
install::_targets() {
  if (( $# > 0 )); then
    printf '%s\n' "$@"
  else
    printf '%s\n' "${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"
  fi
}

#@/private
 # Print the directory one kind's items are linked from.
 #
 # @operand <kind>         Item kind
 # @stdout                 Absolute directory
 ##
install::_src_root() {
  case "$1" in
    instructions) echo "${REPO_ROOT}/common/instructions" ;;
    *) echo "${CLIENT_SRC}/$1" ;;
  esac
}

#@/private
 # Print where one item links to in a config dir.
 #
 # Instructions link to CLAUDE.md, the fixed name Claude Code reads; every
 # other kind keeps the item's own name under the kind's directory.
 #
 # @operand <kind>         Item kind
 # @operand <config_dir>   Absolute config dir
 # @operand <src>          The item's source path
 # @stdout                 Absolute destination path
 ##
install::_dest() {
  local kind="$1"
  local config_dir="$2"
  local src="$3"

  case "${kind}" in
    instructions) echo "${config_dir}/CLAUDE.md" ;;
    *) echo "${config_dir}/${kind}/$(basename "${src}")" ;;
  esac
}

#@/private
 # Test whether a config dir opts out of an item.
 #
 # @operand <kind>         Item kind
 # @operand <src>          The item's source path
 # @operand <config_dir>   Absolute config dir
 #
 # @reads   <config_dir>/.agent-tooling-ignore
 #
 # @exit    0              The item is ignored there
 # @exit    1              It isn't
 ##
install::_ignored() {
  local kind="$1"
  local src="$2"
  local ignore_file="$3/${IGNORE_FILE}"

  [[ -f "${ignore_file}" ]] || return 1
  grep -Fxq "${kind}/$(basename "${src}")" \
    <(sed -e 's/[[:space:]]*#.*//' -e '/^[[:space:]]*$/d' "${ignore_file}")
}

#@/private
 # Print the source paths of one kind's items.
 #
 # @operand <kind>         `instructions`, `skills`, `output-styles`, or
 #                         `hooks`
 # @stdout                 One absolute source path per line
 ##
install::_sources() {
  local kind="$1"
  local src

  case "${kind}" in
    instructions)
      src="${REPO_ROOT}/common/instructions/AGENTS.md"
      [[ -f "${src}" ]] && echo "${src}"
      ;;
    skills)
      for src in "${CLIENT_SRC}/skills"/*/; do
        [[ -f "${src}SKILL.md" ]] && echo "${src%/}"
      done
      ;;
    output-styles)
      for src in "${CLIENT_SRC}/output-styles"/*.md; do
        [[ -f "${src}" ]] && echo "${src}"
      done
      ;;
    hooks)
      for src in "${CLIENT_SRC}/hooks"/*/; do
        [[ -f "${src}settings.json" ]] && echo "${src%/}"
      done
      ;;
  esac
  return 0
}

#@/private
 # Print the settings entries every hook item wants in one config dir.
 #
 # Reads each hook's settings.json fragment, replaces the literal
 # {{config_dir}} in its strings with the config dir, and flattens its
 # `hooks` object into one record per entry. Ignored hooks contribute
 # nothing, so their entries count as stale.
 #
 # @operand <config_dir>   Absolute config dir
 #
 # @stdout                 JSON array of {name, event, entry}
 ##
install::_hook_entries() {
  local config_dir="$1"
  local src

  while IFS= read -r src; do
    install::_ignored hooks "${src}" "${config_dir}" && continue
    jq -c --arg name "$(basename "${src}")" --arg dir "${config_dir}" '
      walk(if type == "string"
           then gsub("\\{\\{config_dir\\}\\}"; $dir) else . end)
      | .hooks // {} | to_entries[] | .key as $event
      | .value[] | {name: $name, event: $event, entry: .}
    ' "${src}/settings.json"
  done < <(install::_sources hooks) | jq -sc '.'
}

#@/private
 # Check, and optionally fix, the hook entries in a config dir's settings.
 #
 # An entry in settings.json belongs to this script when one of its
 # commands names a path under <config_dir>/hooks/. Entries a hook item
 # wants are added when missing; owned entries no item wants any more are
 # removed. Nothing else in the file is touched.
 #
 # @operand <mode>         `install` to fix, `doctor` to only report
 # @operand <config_dir>   Absolute config dir
 #
 # @writes  <config_dir>/settings.json   In install mode, when changed
 #
 # @stdout                 One status line per entry
 # @stderr                 Errors from jq or the write
 #
 # @exit    0              Every wanted entry is present, none is stale
 # @exit    1              Something is missing or stale
 ##
install::_sync_hook_entries() {
  local mode="$1"
  local config_dir="$2"
  local settings="${config_dir}/settings.json"
  local prefix="${config_dir}/hooks/"
  local current wanted report status event name tmp
  local problems=0

  wanted="$(install::_hook_entries "${config_dir}")"
  if [[ -f "${settings}" ]]; then
    current="$(cat "${settings}")"
  else
    current='{}'
  fi

  report="$(jq -r --argjson wanted "${wanted}" --arg prefix "${prefix}" '
    def owned: any(.hooks[]? | .command // ""; contains($prefix));
    def owner_name:
      (first(.hooks[]? | .command // "" | select(contains($prefix)))
       | split($prefix)[1] | split("/")[0]) // "?";
    (.hooks // {}) as $h
    | ($wanted[] | . as $w
       | if ($h[$w.event] // [] | any(.[]; . == $w.entry))
         then "ok \($w.event) \($w.name)"
         else "missing \($w.event) \($w.name)" end),
      ($h | to_entries[] | .key as $event | .value[] | . as $entry
       | select(owned)
       | select(($wanted | any(.[]; .event == $event and .entry == $entry))
                | not)
       | "stale \($event) \(owner_name)")
  ' <<< "${current}")"

  while IFS=' ' read -r status event name; do
    [[ -n "${status}" ]] || continue
    case "${status}" in
      ok)
        echo "ok       ${settings} ${event} ${name}"
        ;;
      missing)
        if [[ "${mode}" == "install" ]]; then
          echo "merged   ${settings} ${event} ${name}"
        else
          echo "missing  ${settings} ${event} ${name}"
          (( problems++ )) || true
        fi
        ;;
      stale)
        if [[ "${mode}" == "install" ]]; then
          echo "removed  ${settings} ${event} ${name}"
        else
          echo "stale    ${settings} ${event} ${name}"
          (( problems++ )) || true
        fi
        ;;
    esac
  done <<< "${report}"

  if [[ "${mode}" == "install" ]] \
      && grep -Eq '^(missing|stale) ' <<< "${report}"; then
    tmp="$(mktemp "${settings}.XXXXXX")"
    jq --argjson wanted "${wanted}" --arg prefix "${prefix}" '
      def owned: any(.hooks[]? | .command // ""; contains($prefix));
      def wanted_for($event):
        [$wanted[] | select(.event == $event) | .entry];
      (.hooks // {}) as $h
      | ([$h | keys[]] + [$wanted[].event] | unique) as $events
      | .hooks = ([ $events[] | . as $event | ($h[$event] // []) as $cur
          | { key: $event,
              value: ([ $cur[] | . as $e
                        | select((owned
                                  and (wanted_for($event)
                                       | any(.[]; . == $e) | not))
                                 | not) ]
                      + [ wanted_for($event)[] | . as $w
                          | select($cur | any(.[]; . == $w) | not) ]) }
        ] | map(select(.value | length > 0)) | from_entries)
      | if (.hooks | length) == 0 then del(.hooks) else . end
    ' <<< "${current}" > "${tmp}" && mv "${tmp}" "${settings}"
  fi

  (( problems == 0 ))
}

#@/private
 # Check, and optionally fix, one kind's links in one config dir.
 #
 # @operand <mode>         `install` to fix, `doctor` to only report
 # @operand <kind>         Item kind
 # @operand <config_dir>   Absolute config dir to check
 #
 # @stdout                 One status line per item
 # @stderr                 Conflicts that need manual attention
 #
 # @exit    0              Every item is linked
 # @exit    1              Something is missing or in the way
 ##
install::_sync() {
  local mode="$1"
  local kind="$2"
  local dest_root="$3/${kind}"
  local src dest link
  local problems=0

  [[ "${kind}" == "instructions" ]] && dest_root="$3"
  [[ "${mode}" == "install" ]] && mkdir -p "${dest_root}"

  while IFS= read -r src; do
    dest="$(install::_dest "${kind}" "$3" "${src}")"

    if install::_ignored "${kind}" "${src}" "$3"; then
      if [[ -L "${dest}" && "$(readlink "${dest}")" == "${src}" ]]; then
        if [[ "${mode}" == "install" ]]; then
          rm "${dest}"
          echo "removed  ${dest} (ignored)"
        else
          echo "stale    ${dest} (ignored)"
          (( problems++ )) || true
        fi
      else
        echo "ignored  ${dest}"
      fi
    elif [[ -L "${dest}" && "$(readlink "${dest}")" == "${src}" ]]; then
      echo "ok       ${dest}"
    elif [[ -e "${dest}" || -L "${dest}" ]]; then
      install::_err "${dest} exists and isn't this repo's link; move it first"
      (( problems++ )) || true
    elif [[ "${mode}" == "install" ]]; then
      ln -s "${src}" "${dest}"
      echo "linked   ${dest}"
    else
      echo "missing  ${dest}"
      (( problems++ )) || true
    fi
  done < <(install::_sources "${kind}")

  # Links into this repo whose item was removed or renamed.
  for link in "${dest_root}"/*; do
    [[ -L "${link}" ]] || continue
    [[ "$(readlink "${link}")" == "$(install::_src_root "${kind}")/"* ]] \
      || continue
    [[ -e "${link}" ]] && continue
    if [[ "${mode}" == "install" ]]; then
      rm "${link}"
      echo "removed  ${link}"
    else
      echo "stale    ${link}"
      (( problems++ )) || true
    fi
  done

  if [[ "${kind}" == "hooks" ]]; then
    install::_sync_hook_entries "${mode}" "$3" || (( problems++ )) || true
  fi

  (( problems == 0 ))
}

#@/private
 # Run a sync mode for every kind across every target config dir.
 #
 # @operand <mode>              `install` or `doctor`
 # @operand [config_dirs...]    Config dirs; see install::_targets
 #
 # @exit    0                   Every config dir is healthy
 # @exit    1                   At least one config dir has problems
 ##
install::_run() {
  local mode="$1"
  shift
  local dir kind
  local failed=0

  while IFS= read -r dir; do
    dir="$(install::_abs "${dir}")" || { failed=1; continue; }
    for kind in "${KINDS[@]}"; do
      install::_sync "${mode}" "${kind}" "${dir}" || failed=1
    done
  done < <(install::_targets "$@")

  return "${failed}"
}

#@/command/doctor
 # Report whether every item is linked, changing nothing.
 #
 # @operand [config_dirs...]  Config dirs (default: $CLAUDE_CONFIG_DIR or
 #                            ~/.claude)
 #
 # @stdout                    One status line per item
 # @stderr                    Conflicts that need manual attention
 #
 # @exit    0                 Healthy
 # @exit    1                 Missing, stale, or conflicting links
 ##
install::doctor() {
  install::_run doctor "$@"
}

#@/command
 # Link every item, fixing what can be fixed safely.
 #
 # @operand [config_dirs...]  Config dirs (default: $CLAUDE_CONFIG_DIR or
 #                            ~/.claude)
 #
 # @stdout                    One status line per item
 # @stderr                    Conflicts that need manual attention
 #
 # @exit    0                 Every item is linked
 # @exit    1                 A conflict was left in place
 ##
install() {
  install::_run install "$@"
}
