#!/usr/bin/env bash

#?/name     standalone — Link standalone items into Claude Code config dirs
#?/version  2.0.0
#?/synopsis standalone {install|doctor} [config_dirs...]
#?/description
 # Symlinks each standalone item under clients/claude/ into a config dir:
 # skills/<name>/ (a directory with SKILL.md) to <config_dir>/skills/<name>,
 # and output-styles/<name>.md to <config_dir>/output-styles/<name>.md. A
 # config dir defaults to $CLAUDE_CONFIG_DIR, or ~/.claude when that is
 # unset. Never replaces anything that isn't one of its own links, and
 # removes its links whose item no longer exists.
 ##

source module

set -euo pipefail

CLIENT_SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
readonly CLIENT_SRC

# Item kinds, each the name of both its source dir under clients/claude/
# and its destination dir in a config dir.
readonly KINDS=(skills output-styles)

#@/private
 # Log an error message to STDERR.
 #
 # @operand <message...>   Error message text
 # @stderr                 Error message
 ##
standalone::_err() {
  echo "standalone: ERROR: $*" >&2
}

#@/private
 # Print the config dirs to act on.
 #
 # @operand [config_dirs...]  Explicit config dirs
 # @env     CLAUDE_CONFIG_DIR Default config dir when no operands are given
 # @stdout                    One config dir per line
 ##
standalone::_targets() {
  if (( $# > 0 )); then
    printf '%s\n' "$@"
  else
    printf '%s\n' "${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"
  fi
}

#@/private
 # Print the source paths of one kind's items.
 #
 # @operand <kind>         `skills` or `output-styles`
 # @stdout                 One absolute source path per line
 ##
standalone::_sources() {
  local kind="$1"
  local src

  case "${kind}" in
    skills)
      for src in "${CLIENT_SRC}/skills"/*/; do
        [[ -f "${src}SKILL.md" ]] && echo "${src%/}"
      done
      ;;
    output-styles)
      for src in "${CLIENT_SRC}/output-styles"/*.md; do
        [[ -f "${src}" ]] && echo "${src}"
      done
      ;;
  esac
  return 0
}

#@/private
 # Check, and optionally fix, one kind's links in one config dir.
 #
 # @operand <mode>         `install` to fix, `doctor` to only report
 # @operand <kind>         `skills` or `output-styles`
 # @operand <config_dir>   Config dir to check
 #
 # @stdout                 One status line per item
 # @stderr                 Conflicts that need manual attention
 #
 # @exit    0              Every item is linked
 # @exit    1              Something is missing or in the way
 ##
standalone::_sync() {
  local mode="$1"
  local kind="$2"
  local dest_root="$3/${kind}"
  local src dest link
  local problems=0

  [[ "${mode}" == "install" ]] && mkdir -p "${dest_root}"

  while IFS= read -r src; do
    dest="${dest_root}/$(basename "${src}")"

    if [[ -L "${dest}" && "$(readlink "${dest}")" == "${src}" ]]; then
      echo "ok       ${dest}"
    elif [[ -e "${dest}" || -L "${dest}" ]]; then
      standalone::_err "${dest} exists and isn't this repo's link; move it first"
      (( problems++ )) || true
    elif [[ "${mode}" == "install" ]]; then
      ln -s "${src}" "${dest}"
      echo "linked   ${dest}"
    else
      echo "missing  ${dest}"
      (( problems++ )) || true
    fi
  done < <(standalone::_sources "${kind}")

  # Links into this repo whose item was removed or renamed.
  for link in "${dest_root}"/*; do
    [[ -L "${link}" ]] || continue
    [[ "$(readlink "${link}")" == "${CLIENT_SRC}/${kind}/"* ]] || continue
    [[ -e "${link}" ]] && continue
    if [[ "${mode}" == "install" ]]; then
      rm "${link}"
      echo "removed  ${link}"
    else
      echo "stale    ${link}"
      (( problems++ )) || true
    fi
  done

  (( problems == 0 ))
}

#@/private
 # Run a sync mode for every kind across every target config dir.
 #
 # @operand <mode>              `install` or `doctor`
 # @operand [config_dirs...]    Config dirs; see standalone::_targets
 #
 # @exit    0                   Every config dir is healthy
 # @exit    1                   At least one config dir has problems
 ##
standalone::_run() {
  local mode="$1"
  shift
  local dir kind
  local failed=0

  while IFS= read -r dir; do
    for kind in "${KINDS[@]}"; do
      standalone::_sync "${mode}" "${kind}" "${dir}" || failed=1
    done
  done < <(standalone::_targets "$@")

  return "${failed}"
}

#@/command/install
 # Link every standalone item, fixing what can be fixed safely.
 #
 # @operand [config_dirs...]  Config dirs (default: $CLAUDE_CONFIG_DIR or
 #                            ~/.claude)
 #
 # @stdout                    One status line per item
 # @stderr                    Conflicts that need manual attention
 #
 # @exit    0                 Every item is linked
 # @exit    1                 A conflict was left in place
 ##
standalone::install() {
  standalone::_run install "$@"
}

#@/command/doctor
 # Report whether every standalone item is linked, changing nothing.
 #
 # @operand [config_dirs...]  Config dirs (default: $CLAUDE_CONFIG_DIR or
 #                            ~/.claude)
 #
 # @stdout                    One status line per item
 # @stderr                    Conflicts that need manual attention
 #
 # @exit    0                 Healthy
 # @exit    1                 Missing, stale, or conflicting links
 ##
standalone::doctor() {
  standalone::_run doctor "$@"
}

#@/command
 # Link standalone items into Claude Code config dirs.
 #
 # @stderr                 Usage message
 #
 # @exit    1              Prints usage and exits
 ##
standalone() {
  standalone::_err "Usage: standalone {install|doctor} [config_dirs...]"
  return 1
}
