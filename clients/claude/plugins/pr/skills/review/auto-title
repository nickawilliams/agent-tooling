#!/usr/bin/env bash

#?/name     auto-title — Session title for a pull request review
#?/version  1.1.0
#?/synopsis auto-title < hook-payload.json
#?/description
 # Handler for the auto-title plugin, which runs it when a prompt
 # invokes /pr:review or bare /review. Reads the UserPromptSubmit
 # payload and prints `review: <repo> #<number>`, or nothing when there
 # is no PR to name, which auto-title treats as declining.
 #
 # The repo name comes from the `origin` remote, not from GitHub, so a
 # prompt that carries the number needs no network at all. Only a prompt
 # with no number asks GitHub which open PR the current branch has, and
 # it does so over REST: in a cloud session the GitHub proxy rejects
 # GraphQL, which `gh pr` is built on, so `gh pr view` would fail there.
 #
 # auto-title runs it in the session's working directory, so git and gh
 # resolve the repo the way the review itself does. Needs bash, git,
 # and jq; gh only for the no-number case. No module-sh, as with every
 # script a hook runs here.
 ##

set -uo pipefail

payload="$(cat)"

command -v jq >/dev/null 2>&1 || exit 0
command -v git >/dev/null 2>&1 || exit 0

prompt="$(jq -r '.prompt // empty' <<< "${payload}")"

# Owner and repo from the remote, in any of the forms git accepts:
# https://github.com/o/r(.git), git@github.com:o/r(.git), ssh://git@github.com/o/r.
# A cloud session's clone is built from a seed bundle and has no remote
# at all, so both stay empty there and the title degrades to the number.
owner=""
repo=""
remote="$(git remote get-url origin 2>/dev/null)" || remote=""
remote="${remote%.git}"
remote="${remote%/}"
if [[ "${remote}" =~ [:/]([^/:]+)/([^/]+)$ ]]; then
  owner="${BASH_REMATCH[1]}"
  repo="${BASH_REMATCH[2]}"
fi

# The number is the first operand, as the skill's argument-hint has it,
# with or without a leading '#'. Anything else, such as a flag, means
# "the current branch's PR".
number=""
if [[ "${prompt}" =~ ^/[^[:space:]]+[[:space:]]+#?([0-9]+)([[:space:]]|$) ]]; then
  number="${BASH_REMATCH[1]}"
fi

if [[ -z "${number}" ]]; then
  # Finding the branch's PR needs the repo; with no remote there is
  # nothing to ask.
  [[ -n "${repo}" ]] || exit 0
  command -v gh >/dev/null 2>&1 || exit 0
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" || exit 0
  [[ -n "${branch}" && "${branch}" != "HEAD" ]] || exit 0
  number="$(gh api "repos/${owner}/${repo}/pulls?state=open&head=${owner}:${branch}" \
    --jq '.[0].number // empty' 2>/dev/null)" || exit 0
  [[ -n "${number}" ]] || exit 0
fi

if [[ -n "${repo}" ]]; then
  printf 'review: %s #%s\n' "${repo}" "${number}"
else
  printf 'review: #%s\n' "${number}"
fi
