#!/usr/bin/env bash

#?/name     auto-title — Session title fields for a pull request review
#?/version  3.0.0
#?/synopsis auto-title < hook-payload.json
#?/description
 # Handler for the auto-title plugin, which runs it when a prompt
 # invokes /pr:review or bare /review. Reads the UserPromptSubmit
 # payload and prints the title's fields as JSON: the issue, the PR's
 # title as the name, the verb `review`, and `<repo>#<number>` as the
 # target, which the plugin assembles into
 # `EX-1337 · timecard sync drops overtime · review → api#3442`. With no
 # PR to name it prints nothing, which auto-title treats as declining.
 #
 # The PR is the prompt's first operand: a number (with or without `#`),
 # `<owner>/<repo>#<n>`, or a PR URL. The last two also name the repo;
 # a bare number leaves that to the `origin` remote, so outside a
 # checkout the full form is required, as it is for the skill. With no
 # operand, the open PR for the current branch. One REST call then
 # fetches the PR's number, title, and head branch. REST, because in a
 # cloud session the GitHub proxy rejects GraphQL, which `gh pr` is
 # built on. A cloud clone also has no remote, so a bare number there
 # yields only the target, `#<n>`.
 #
 # The issue is the first of: `--issue=<key>` in the prompt, a key in
 # the PR's title, a key in its branch name. The name is the PR's title
 # as fetched; the plugin strips the key and slugifies it.
 #
 # auto-title runs it in the session's working directory, so git and gh
 # resolve the repo the way the review itself does. Needs bash, git,
 # and jq; gh only for the lookup. No module-sh, as with every script a
 # hook runs here.
 ##

set -uo pipefail

# An issue key as tooling writes it in titles and branch names: an
# upper-case, letters-only project prefix, preceded by a non-word
# character or the start of the string. No trailing boundary:
# `EX-123_slug` holds a key.
readonly KEY_PATTERN='(^|[^A-Za-z0-9])([A-Z]{2,10}-[0-9]+)'

# Prefixes that look like project keys in a title and aren't.
readonly NOT_KEYS=" UTF SHA ISO HTTP TLS SSL CVE RFC PEP MD UTC "

#@/private
 # Print the first issue key in a string, skipping known look-alikes.
 #
 # @operand <text>         PR title or branch name
 #
 # @stdout                 The key, or nothing
 ##
auto_title::_key() {
  local text="${1}" key

  while [[ "${text}" =~ ${KEY_PATTERN} ]]; do
    key="${BASH_REMATCH[2]}"
    if [[ "${NOT_KEYS}" != *" ${key%%-*} "* ]]; then
      printf '%s' "${key}"
      return 0
    fi
    text="${text#*"${key}"}"
  done
}

payload="$(cat)"

command -v jq >/dev/null 2>&1 || exit 0
command -v git >/dev/null 2>&1 || exit 0

prompt="$(jq -r '.prompt // empty' <<< "${payload}")"

# The first operand, if the prompt has one. Anything that isn't one of
# the PR forms below, such as a flag, means "the current branch's PR".
operand=""
if [[ "${prompt}" =~ ^/[^[:space:]]+[[:space:]]+([^[:space:]]+) ]]; then
  operand="${BASH_REMATCH[1]}"
fi

owner=""
repo=""
number=""
if [[ "${operand}" =~ ^#?([0-9]+)$ ]]; then
  number="${BASH_REMATCH[1]}"
elif [[ "${operand}" =~ ^([^/#[:space:]]+)/([^/#[:space:]]+)#([0-9]+)$ ]]; then
  owner="${BASH_REMATCH[1]}"
  repo="${BASH_REMATCH[2]}"
  number="${BASH_REMATCH[3]}"
elif [[ "${operand}" =~ ^https?://[^/]+/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
  owner="${BASH_REMATCH[1]}"
  repo="${BASH_REMATCH[2]}"
  number="${BASH_REMATCH[3]}"
fi

# Otherwise, owner and repo from the remote, in any of the forms git
# accepts: https://github.com/o/r(.git), git@github.com:o/r(.git),
# ssh://git@github.com/o/r. A cloud session's clone is built from a seed
# bundle and has no remote at all, so both stay empty there.
if [[ -z "${repo}" ]]; then
  remote="$(git remote get-url origin 2>/dev/null)" || remote=""
  remote="${remote%.git}"
  remote="${remote%/}"
  if [[ "${remote}" =~ [:/]([^/:]+)/([^/]+)$ ]]; then
    owner="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
  fi
fi

# An explicit --issue wins: a Jira key in any case, or an issue number.
issue=""
if [[ "${prompt}" =~ (^|[[:space:]])--issue[=[:space:]]+([^[:space:]]+) ]]; then
  value="${BASH_REMATCH[2]}"
  if [[ "${value}" =~ ^[A-Za-z]{2,10}-[0-9]+$ ]]; then
    issue="$(printf '%s' "${value}" | tr '[:lower:]' '[:upper:]')"
  elif [[ "${value}" =~ ^#?([0-9]+)$ ]]; then
    issue="#${BASH_REMATCH[1]}"
  fi
fi

# One call to GitHub, when there is a repo to ask about: the name needs
# the PR's title, and a missing number needs the branch's PR.
pr_title=""
if [[ -n "${repo}" ]] && command -v gh >/dev/null 2>&1; then
  fields='[(.number | tostring), .title, .head.ref] | join("\u001f")'
  if [[ -n "${number}" ]]; then
    found="$(gh api "repos/${owner}/${repo}/pulls/${number}" \
      --jq "${fields}" 2>/dev/null)" || found=""
  else
    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" || branch=""
    found=""
    if [[ -n "${branch}" && "${branch}" != "HEAD" ]]; then
      found="$(gh api \
        "repos/${owner}/${repo}/pulls?state=open&head=${owner}:${branch}" \
        --jq ".[0] // empty | ${fields}" 2>/dev/null)" || found=""
    fi
  fi

  if [[ -n "${found}" ]]; then
    IFS=$'\x1f' read -r found_number pr_title ref <<< "${found}"
    number="${number:-${found_number}}"
    [[ -n "${issue}" ]] || issue="$(auto_title::_key "${pr_title}")"
    [[ -n "${issue}" ]] || issue="$(auto_title::_key "${ref}")"
  fi
fi

[[ -n "${number}" ]] || exit 0

jq -nc --arg issue "${issue}" --arg name "${pr_title}" \
  --arg target "${repo:+${repo}}#${number}" \
  '{issue: $issue, name: $name, verb: "review", target: $target}'
